{
  "manifest_version": 3,
  "name": "Access Token Copier",
  "version": "1.0",
  "description": "Copy and paste access_token cookies across websites.",
  "permissions": ["cookies", "storage", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Access Token Copier"
  }
}
