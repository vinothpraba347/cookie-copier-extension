{
  "manifest_version": 3,
  "name": "TokenHop",
  "version": "1.2",
  "description": "Hop cookies & access tokens between sites — copy, paste, manage, and debug with one click.",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TokenHop"
  }
}
